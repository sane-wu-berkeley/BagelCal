{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "enum": [
        "illustrative",
        "elicited",
        "person_a"
      ]
    },
    "suggested_weights": {
      "type": "object",
      "properties": {
        "security": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "growth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "autonomy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "connection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meaning": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "security",
        "growth",
        "autonomy",
        "connection",
        "meaning"
      ],
      "additionalProperties": false
    },
    "actions": {
      "minItems": 2,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expected_utility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "expected_regret": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "tail_regret": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score": {
            "type": "number",
            "minimum": -3,
            "maximum": 1
          },
          "criteria": {
            "type": "object",
            "properties": {
              "security": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "growth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "autonomy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "connection": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "meaning": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "security",
              "growth",
              "autonomy",
              "connection",
              "meaning"
            ],
            "additionalProperties": false
          },
          "timeline": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 5
                    },
                    {
                      "type": "number",
                      "const": 20
                    }
                  ]
                },
                "regret": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "year",
                "regret"
              ],
              "additionalProperties": false
            }
          },
          "evidence_ids": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "required": [
          "option_id",
          "expected_utility",
          "expected_regret",
          "tail_regret",
          "score",
          "criteria",
          "timeline",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "scenario",
            "estimated"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sample_count": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "description",
        "sample_count"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "illustrative",
              "user_provided",
              "observed",
              "model_estimated"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "population": {
            "type": "string",
            "maxLength": 1000
          },
          "geography": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "source",
          "year",
          "population",
          "geography"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "source",
    "suggested_weights",
    "actions",
    "uncertainty",
    "evidence",
    "assumptions",
    "method"
  ],
  "additionalProperties": false
}

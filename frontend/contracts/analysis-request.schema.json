{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "profile": {
      "type": "string",
      "maxLength": 6000
    },
    "philosophy": {
      "type": "string",
      "maxLength": 300
    },
    "options": {
      "minItems": 2,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^option_[0-4]$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "feasible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "feasible"
        ],
        "additionalProperties": false
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "security": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "growth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "autonomy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "connection": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meaning": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "security",
        "growth",
        "autonomy",
        "connection",
        "meaning"
      ],
      "additionalProperties": false
    },
    "risk_aversion": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "scenario_inputs": {
      "minItems": 2,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^option_[0-4]$"
          },
          "spread": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "horizons": {
            "minItems": 3,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 5
                    },
                    {
                      "type": "number",
                      "const": 20
                    }
                  ]
                },
                "criteria": {
                  "type": "object",
                  "properties": {
                    "security": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "growth": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "autonomy": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "connection": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "meaning": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "security",
                    "growth",
                    "autonomy",
                    "connection",
                    "meaning"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "year",
                "criteria"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "option_id",
          "spread",
          "horizons"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "question",
    "profile",
    "philosophy",
    "options",
    "weights",
    "risk_aversion"
  ],
  "additionalProperties": false
}
